FROM node:20-bullseye AS builder

# Build deps for native modules (better-sqlite3)
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Enable pnpm via corepack
RUN corepack enable

WORKDIR /app

# Copy lockfiles first for better cache
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install deps (allow lockfile update for new dependencies)
RUN pnpm install --no-frozen-lockfile

# Copy source and build
COPY . .

# Build-time app config
ARG VITE_DATA_MODE=offline
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ENV VITE_DATA_MODE=$VITE_DATA_MODE \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Disable code splitting to avoid file:// loading issues in Electron
ENV VITE_ENABLE_CODE_SPLITTING=false
RUN pnpm build

FROM nginx:1.27-alpine

# SPA fallback config
COPY docker/web/nginx.conf /etc/nginx/conf.d/default.conf

# Copy build output
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

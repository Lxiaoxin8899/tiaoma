# 说明：拷贝此文件为 supabase.env 并替换为安全值
# - JWT_SECRET 需至少 32 位
# - ANON_KEY / SERVICE_ROLE_KEY 需使用同一 JWT_SECRET 重新签名
# - 若使用外部数据库，请同步更新 PGRST_DB_URI / GOTRUE_DB_DATABASE_URL

POSTGRES_PASSWORD=change_me
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# 说明：数据库连接（用于迁移脚本；本地 DB 容器可保持默认）
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=postgres

# 说明：JWT 密钥（至少 32 位）
JWT_SECRET=change_me_with_32_chars_or_more
ANON_KEY=change_me_anon_jwt
SERVICE_ROLE_KEY=change_me_service_role_jwt

# 说明：API/认证服务统一数据库连接串
PGRST_DB_URI=postgres://postgres:change_me@db:5432/postgres
GOTRUE_DB_DATABASE_URL=postgres://postgres:change_me@db:5432/postgres

# 说明：GoTrue 相关配置
GOTRUE_SITE_URL=http://localhost:5173
GOTRUE_URI_ALLOW_LIST=http://localhost:5173
GOTRUE_JWT_SECRET=change_me_with_32_chars_or_more
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_EXTERNAL_EMAIL_ENABLED=true

# 说明：PostgREST 相关配置
PGRST_JWT_SECRET=change_me_with_32_chars_or_more

# 说明：前端与认证的回跳/白名单地址
SITE_URL=http://localhost:5173
API_EXTERNAL_URL=http://localhost:8000

# 说明：Realtime 使用的密钥（未启用 realtime 时可忽略）
REALTIME_SECRET_KEY_BASE=change_me_realtime_secret
